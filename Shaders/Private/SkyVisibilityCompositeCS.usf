/*
* Full-res composite: upsample intermediate skyVis and min into GBufferC.a via UAV RMW.
*/

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"

Texture2D<float>    SkyVisTexture;
Texture2D<float4>   GBufferBTexture;
SamplerState        LinearClampSampler;
SamplerState        PointClampSampler;

int2                ViewOffset;
int2                ViewSize;
int2                SkyVisSize;

// UAV-only RMW — do not also bind GBufferC as SRV
RWTexture2D<float4> GBufferCUAV;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (any(DispatchThreadID.xy >= (uint2)ViewSize))
	{
		return;
	}

	int2 PixelIndex = int2(DispatchThreadID.xy) + ViewOffset;

	float2 BufferUV = (float2(PixelIndex) + 0.5f) * View.BufferSizeAndInvSize.zw;
	float4 GBufferB = GBufferBTexture.SampleLevel(PointClampSampler, BufferUV, 0);
	uint ShadingModelId = DecodeShadingModelId(GBufferB.a);
	if (ShadingModelId == SHADINGMODELID_UNLIT)
	{
		return;
	}

	float2 SkyVisUV = (float2(DispatchThreadID.xy) + 0.5f) / float2(ViewSize);
	float skyVis = SkyVisTexture.SampleLevel(LinearClampSampler, SkyVisUV, 0).r;

	float4 GBufferC = GBufferCUAV[PixelIndex];
	GBufferC.a = min(GBufferC.a, skyVis);
	GBufferCUAV[PixelIndex] = GBufferC;
}
