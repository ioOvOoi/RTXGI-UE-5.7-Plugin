*
* 全分辨率 composite：采样低分辨率 skyVis，min 写入 GBufferC.a（GBufferAO）。
*
* 为什么 min：保护材质自带 AO，只允许更暗不能更亮（与 DFAO/SSAO 合成习惯一致）。
* 为什么 UAV RMW、禁止再绑 GBufferC SRV：同资源 SRV+UAV 未定义；用 TypedUAVLoad 读-改-写 .a。
* 为什么必须单独全分辨率 pass：低分辨率禁止直接 scatter 写全分辨率 GBuffer。
*
* SkyVis_GBufferB 仅用于 DecodeShadingModelId 跳过 Unlit。
*/

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"

Texture2D<float>    SkyVisTexture;
Texture2D<float4>   SkyVis_GBufferB;
SamplerState        LinearClampSampler;
SamplerState        PointClampSampler;

int2                ViewOffset;
int2                ViewSize;
int2                SkyVisSize;

// UAV-only RMW — do not also bind GBufferC as SRV
RWTexture2D<float4> SkyVis_GBufferCUAV;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (any(DispatchThreadID.xy >= (uint2)ViewSize))
	{
		return;
	}

	int2 PixelIndex = int2(DispatchThreadID.xy) + ViewOffset;

	float2 BufferUV = (float2(PixelIndex) + 0.5f) * View.BufferSizeAndInvSize.zw;
	float4 GBufferB = SkyVis_GBufferB.SampleLevel(PointClampSampler, BufferUV, 0);
	uint ShadingModelId = DecodeShadingModelId(GBufferB.a);
	if (ShadingModelId == SHADINGMODELID_UNLIT)
	{
		return;
	}

	float2 SkyVisUV = (float2(DispatchThreadID.xy) + 0.5f) / float2(ViewSize);
	float skyVis = SkyVisTexture.SampleLevel(LinearClampSampler, SkyVisUV, 0).r;

	float4 GBufferC = SkyVis_GBufferCUAV[PixelIndex];
	GBufferC.a = min(GBufferC.a, skyVis);
	SkyVis_GBufferCUAV[PixelIndex] = GBufferC;
}
