#include "/Plugin/RTXGI/Private/SDK/SGBasis.ush"

#ifndef SG_LOBE_COUNT
#define SG_LOBE_COUNT 12
#endif

// Skeleton compute shader for future DDGI ray-radiance to fixed-basis SG amplitude projection.
// Projection resources and dispatch are intentionally added in later tasks (3.2-3.6).
[numthreads(1, 1, 1)]
void DDGIProbeSGProjectCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	// Touch the basis helper so unsupported SG_LOBE_COUNT permutations fail during shader compile.
	float BasisWeight = RTXGISGEvaluate(float3(0.0f, 0.0f, 1.0f), 0);
	(void)BasisWeight;
}
