/*
* Copyright (c) 2019-2022, NVIDIA CORPORATION.  All rights reserved.
*
* 低分辨率 Sky Visibility 计算（CS）。
*
* 输入：SceneDepth / GBufferA(法线) / GBufferB(着色模型) / 最多 4 个 volume 的探针 distance（及 offsets/states）。
* 输出：中间 RT（R16F）存 openness [0,1]（1=完全见天）。
*
* 为什么纹理叫 SkyVis_*：DeferredShadingCommon.ush 已声明 GBufferBTexture 等同名，
* 再声明会 SM6 redefinition。绑定侧 C++ 参数名必须与这里一致。
*
* 算法概要：
* 1) 重建世界位置与法线；跳过天空像素(DeviceZ==0)与 Unlit；
* 2) densest-first：落在体积内的最密 volume 求值；
* 3) 对 8 邻域探针 × N 半球方向采样 distance，softNear/Far 映射开阔度；
* 4) openness = lerp(max(全局Leak, volumeLeak), 1, skyVis)，再 * volume Intensity。
*/

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "/Plugin/RTXGI/Private/SDK/ddgi/Irradiance.ush"

#ifndef RTXGI_SKYVIS_MAX_VOLUMES
#define RTXGI_SKYVIS_MAX_VOLUMES 4
#endif

Texture2D<float>    SkyVis_SceneDepth;
Texture2D<float4>   SkyVis_GBufferA;
Texture2D<float4>   SkyVis_GBufferB;

SamplerState        PointClampSampler;
SamplerState        LinearClampSampler;

int2                ViewOffset;
int2                DispatchSize;
int2                FullViewSize;
int                 SampleCount;
float               SoftNear;
float               SoftFar;
float               WorldUpBias;
float               SoftLeakFloor;
int                 NumVolumes;

Texture2D<float4>   Volume_0_ProbeDistance;
Texture2D<float4>   Volume_0_ProbeOffsets;
Texture2D<uint>     Volume_0_ProbeStates;
float3              Volume_0_Position;
float4              Volume_0_Rotation;
float3              Volume_0_Radius;
float3              Volume_0_ProbeGridSpacing;
int3                Volume_0_ProbeGridCounts;
int                 Volume_0_ProbeNumDistanceTexels;
int3                Volume_0_ProbeScrollOffsets;
float               Volume_0_SkyVisibilityIntensity;
float               Volume_0_SkyLightLeak;

Texture2D<float4>   Volume_1_ProbeDistance;
Texture2D<float4>   Volume_1_ProbeOffsets;
Texture2D<uint>     Volume_1_ProbeStates;
float3              Volume_1_Position;
float4              Volume_1_Rotation;
float3              Volume_1_Radius;
float3              Volume_1_ProbeGridSpacing;
int3                Volume_1_ProbeGridCounts;
int                 Volume_1_ProbeNumDistanceTexels;
int3                Volume_1_ProbeScrollOffsets;
float               Volume_1_SkyVisibilityIntensity;
float               Volume_1_SkyLightLeak;

Texture2D<float4>   Volume_2_ProbeDistance;
Texture2D<float4>   Volume_2_ProbeOffsets;
Texture2D<uint>     Volume_2_ProbeStates;
float3              Volume_2_Position;
float4              Volume_2_Rotation;
float3              Volume_2_Radius;
float3              Volume_2_ProbeGridSpacing;
int3                Volume_2_ProbeGridCounts;
int                 Volume_2_ProbeNumDistanceTexels;
int3                Volume_2_ProbeScrollOffsets;
float               Volume_2_SkyVisibilityIntensity;
float               Volume_2_SkyLightLeak;

Texture2D<float4>   Volume_3_ProbeDistance;
Texture2D<float4>   Volume_3_ProbeOffsets;
Texture2D<uint>     Volume_3_ProbeStates;
float3              Volume_3_Position;
float4              Volume_3_Rotation;
float3              Volume_3_Radius;
float3              Volume_3_ProbeGridSpacing;
int3                Volume_3_ProbeGridCounts;
int                 Volume_3_ProbeNumDistanceTexels;
int3                Volume_3_ProbeScrollOffsets;
float               Volume_3_SkyVisibilityIntensity;
float               Volume_3_SkyLightLeak;

RWTexture2D<float>  SkyVisOutput;

bool IsInsideVolume(float3 WorldPosition, float3 Origin, float4 Rotation, float3 Radius)
{
	float3 RelPos = WorldPosition - Origin;
	RelPos = abs(RTXGIQuaternionRotate(RelPos, RTXGIQuaternionConjugate(Rotation)));
	return RelPos.x <= Radius.x && RelPos.y <= Radius.y && RelPos.z <= Radius.z;
}

float EvalVolumeSkyVisibility(
	float3 WorldPosition,
	float3 Normal,
	Texture2D<float4> ProbeDistance,
	Texture2D<float4> ProbeOffsets,
	Texture2D<uint> ProbeStates,
	float3 Position,
	float4 Rotation,
	float3 ProbeGridSpacing,
	int3 ProbeGridCounts,
	int ProbeNumDistanceTexels,
	int3 ProbeScrollOffsets,
	float Intensity,
	float VolumeLeak)
{
	DDGIVolumeDescGPU Volume;
	Volume.origin = Position;
	Volume.rotation = Rotation;
	Volume.probeGridSpacing = ProbeGridSpacing;
	Volume.probeGridCounts = ProbeGridCounts;
	Volume.probeNumDistanceTexels = ProbeNumDistanceTexels;
	Volume.probeNumIrradianceTexels = ProbeNumDistanceTexels; // unused by skyVis
	Volume.probeIrradianceEncodingGamma = 1.0f;
	Volume.normalBias = 0.0f;
	Volume.viewBias = 0.0f;
	Volume.probeScrollOffsets = ProbeScrollOffsets;

	DDGIVolumeResources Resources;
	Resources.probeIrradianceSRV = ProbeDistance; // unused
	Resources.probeDistanceSRV = ProbeDistance;
	Resources.bilinearSampler = LinearClampSampler;
#if RTXGI_DDGI_PROBE_RELOCATION
	Resources.probeOffsetsSRV = ProbeOffsets;
#endif
#if RTXGI_DDGI_PROBE_CLASSIFICATION
	Resources.probeStatesSRV = ProbeStates;
#endif

	float skyVis = DDGIGetVolumeSkyVisibility(WorldPosition, Normal, Volume, Resources, SampleCount, SoftNear, SoftFar, WorldUpBias);
	// skyVis: 0=封闭遮挡, 1=见天。
	// leak: 仅当封闭时 openness 的下限（默认 0.5），让室内不完全死黑；见天时 openness=1，不改原亮。
	// 注意：openness 永远 ≤1，后续 composite 对 GBufferAO 做 min，绝不会比原材质 AO 更亮。
	// Intensity: 0=本 volume 不参与压暗；1=完整应用。
	float leak = max(SoftLeakFloor, saturate(VolumeLeak));
	float openness = lerp(leak, 1.0f, skyVis);
	return lerp(1.0f, openness, Intensity);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	if (any(DispatchThreadID.xy >= (uint2)DispatchSize))
	{
		return;
	}

	// 低分辨率线程映射到全分辨率 GBuffer 采样中心，避免半像素偏移。
	float2 FullUV = (float2(DispatchThreadID.xy) + 0.5f) / float2(DispatchSize);
	int2 FullPixel = int2(FullUV * float2(FullViewSize)) + ViewOffset;
	float2 BufferUV = (float2(FullPixel) + 0.5f) * View.BufferSizeAndInvSize.zw;

	float DeviceZ = SkyVis_SceneDepth.SampleLevel(PointClampSampler, BufferUV, 0).r;
	if (DeviceZ == 0.0f)
	{
		SkyVisOutput[DispatchThreadID.xy] = 1.0f;
		return;
	}

	// Unlit 无间接/天光语义，写 1（不压暗）并跳过，避免污染 UI/特效。
	float4 GBufferB = SkyVis_GBufferB.SampleLevel(PointClampSampler, BufferUV, 0);
	uint ShadingModelId = DecodeShadingModelId(GBufferB.a);
	if (ShadingModelId == SHADINGMODELID_UNLIT)
	{
		SkyVisOutput[DispatchThreadID.xy] = 1.0f;
		return;
	}

	float SceneDepth = ConvertFromDeviceZ(DeviceZ);
	float2 ScreenPos = FullUV * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f);
	float3 InScreenVector = mul(float4(ScreenPos, 1, 0), View.ScreenToTranslatedWorld).xyz;
#if UE4_COMPAT
	float3 WorldPosition = InScreenVector * SceneDepth + View.WorldCameraOrigin;
#else
	float3 WorldPosition = InScreenVector * SceneDepth + LWCHackToFloat(PrimaryView.WorldCameraOrigin);
#endif
	float3 Normal = normalize(DecodeNormal(SkyVis_GBufferA.SampleLevel(PointClampSampler, BufferUV, 0).xyz));

	// densest-first：列表已按密度降序绑定，第一个包含像素的 volume 胜出（与 ApplyLighting 一致）。
	float Result = 1.0f;
	bool bFound = false;

#define TRY_VOLUME(i) \
	if (!bFound && i < NumVolumes) \
	{ \
		if (IsInsideVolume(WorldPosition, Volume_##i##_Position, Volume_##i##_Rotation, Volume_##i##_Radius)) \
		{ \
			Result = EvalVolumeSkyVisibility( \
				WorldPosition, Normal, \
				Volume_##i##_ProbeDistance, Volume_##i##_ProbeOffsets, Volume_##i##_ProbeStates, \
				Volume_##i##_Position, Volume_##i##_Rotation, Volume_##i##_ProbeGridSpacing, \
				Volume_##i##_ProbeGridCounts, Volume_##i##_ProbeNumDistanceTexels, \
				Volume_##i##_ProbeScrollOffsets, Volume_##i##_SkyVisibilityIntensity, \
				Volume_##i##_SkyLightLeak); \
			bFound = true; \
		} \
	}

	TRY_VOLUME(0)
	TRY_VOLUME(1)
	TRY_VOLUME(2)
	TRY_VOLUME(3)
#undef TRY_VOLUME

	SkyVisOutput[DispatchThreadID.xy] = Result;
}
